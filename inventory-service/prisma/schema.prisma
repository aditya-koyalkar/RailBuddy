generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InventoryStatus {
  ACTIVE
  CANCELLED
  COMPLETED
}

enum ReservationStatus {
  LOCKED
  BOOKED
  CANCELLED
  EXPIRED
}

model IdempotencyRecord {
  id String @id @default(uuid())

  eventKey String @unique
  response Json?

  processedAt DateTime @default(now())

  @@index([eventKey])
  @@map("idempotency_records")
}

model ScheduleInventory {
  id String @id @default(uuid())

  scheduleId String @unique

  trainId String

  departureDate DateTime @db.Date

  totalSeats Int

  version Int @default(0)

  status InventoryStatus @default(ACTIVE)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  seats SeatInventory[]

  reservations SeatSegmentReservation[]

  @@index([trainId])
  @@index([departureDate])
  @@map("schedule_inventory")
}

model SeatInventory {
  id String @id @default(uuid())

  scheduleInventoryId String

  scheduleId String

  seatId String

  coachId String

  coachNumber String

  coachType String

  seatNumber Int

  seatLabel String

  seatType String

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  scheduleInventory ScheduleInventory @relation(fields: [scheduleInventoryId], references: [id], onDelete: Cascade)

  reservations SeatSegmentReservation[]

  @@unique([scheduleId, seatId])
  @@index([scheduleId])
  @@index([coachNumber])
  @@index([coachType])
  @@map("seat_inventory")
}

model RouteStop {
  id String @id @default(uuid())

  scheduleId String

  stationId String

  stationCode String

  stationName String

  sequence Int

  arrivalDay Int?

  departureDay Int?

  arrivalMinute Int?

  departureMinute Int?

  @@unique([scheduleId, sequence])
  @@index([scheduleId])
  @@index([stationId])
  @@map("route_stops")
}

model SeatSegmentReservation {
  id String @id @default(uuid())

  scheduleInventoryId String

  seatInventoryId String

  bookingId String

  scheduleId String

  seatId String

  fromStationId String

  toStationId String

  fromSequence Int

  toSequence Int

  status ReservationStatus

  lockedBy String?

  lockedAt DateTime?

  expiresAt DateTime?

  version Int @default(0)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  scheduleInventory ScheduleInventory @relation(fields: [scheduleInventoryId], references: [id], onDelete: Cascade)

  seatInventory SeatInventory @relation(fields: [seatInventoryId], references: [id], onDelete: Cascade)

  @@index([scheduleId, seatId])
  @@index([scheduleId, status])
  @@index([bookingId])
  @@index([expiresAt, status])
  @@index([scheduleId, fromSequence, toSequence])
  @@map("seat_segment_reservations")
}

model InventoryOutbox {
  id String @id @default(uuid())

  aggregateType String

  aggregateId String

  eventType String

  payload Json

  published Boolean @default(false)

  publishedAt DateTime?

  createdAt DateTime @default(now())

  @@index([published])
  @@index([aggregateType, aggregateId])
  @@map("inventory_outbox")
}
