generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CoachType {
  GENERAL
  FIRST_CLASS
}

enum SeatType {
  LOWER
  UPPER
}

enum ScheduleStatus {
  ACTIVE
  CANCELLED
  COMPLETED
}

model Station {
  id String @id @default(ulid())

  code  String  @unique
  name  String
  city  String
  state String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  routeStops RouteStop[]

  @@index([city])
  @@index([name])
  @@map("stations")
}

model Train {
  id String @id @default(uuid())

  trainNumber String @unique
  name        String

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coaches Coach[]

  route Route?

  schedules Schedule[]

  fares Fare[]

  @@map("trains")
}

model Coach {
  id String @id @default(uuid())

  trainId String

  coachNumber String

  coachType CoachType

  seatCount Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  train Train @relation(fields: [trainId], references: [id], onDelete: Cascade)

  seats Seat[]

  @@unique([trainId, coachNumber])
  @@index([coachType])
  @@map("coaches")
}

model Seat {
  id String @id @default(uuid())

  coachId String

  seatNumber Int

  seatLabel String

  seatType SeatType

  isActive Boolean @default(true)

  coach Coach @relation(fields: [coachId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([coachId, seatNumber])
  @@map("seats")
}

model Route {
  id String @id @default(uuid())

  trainId String @unique

  train Train @relation(fields: [trainId], references: [id], onDelete: Cascade)

  stops RouteStop[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@map("routes")
}

model RouteStop {
  id String @id @default(uuid())

  routeId String

  stationId String

  sequence Int

  arrivalDay Int?

  departureDay Int?

  arrivalMinute Int?

  departureMinute Int?

  haltMinutes Int?

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)

  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([routeId, sequence])
  @@unique([routeId, stationId])
  @@index([stationId])
  @@map("route_stops")
}

model Schedule {
  id String @id @default(uuid())

  trainId String

  departureDate DateTime @db.Date

  status ScheduleStatus @default(ACTIVE)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  train Train @relation(fields: [trainId], references: [id], onDelete: Cascade)

  @@unique([trainId, departureDate])
  @@index([departureDate])
  @@map("schedules")
}

model Fare {
  id String @id @default(uuid())

  trainId String

  fromStationId String

  toStationId String

  coachType CoachType

  fare Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  train Train @relation(fields: [trainId], references: [id], onDelete: Cascade)

  @@index([trainId])
  @@map("fares")
}
