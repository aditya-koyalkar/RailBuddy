generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  PENDING
  SEATS_LOCKED
  PAYMENT_PENDING
  CONFIRMED
  FAILED
  CANCELLED
  EXPIRED
}

enum PassengerGender {
  MALE
  FEMALE
  OTHER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum SagaStep {
  LOCK_SEATS
  CREATE_PAYMENT
  CONFIRM_SEATS
  CANCEL_SEATS
  COMPLETE
}

enum SagaStatus {
  PENDING
  COMPLETED
  FAILED
  COMPENSATED
}

model Booking {
  id String @id @default(uuid())

  pnr String @unique

  userId String

  scheduleId String

  trainId String

  trainNumber String

  trainName String

  departureDate DateTime @db.Date

  fromStationId String

  fromStationCode String

  fromStationName String

  toStationId String

  toStationCode String

  toStationName String

  fromSequence Int

  toSequence Int

  passengerCount Int

  totalFare Decimal @db.Decimal(10, 2)

  status BookingStatus @default(PENDING)

  idempotencyKey String @unique

  version Int @default(0)

  failureReason String?

  confirmedAt DateTime?

  cancelledAt DateTime?

  expiresAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  passengers Passenger[]

  seatAssignments SeatAssignment[]

  payment Payment?

  sagaLogs SagaLog[]

  @@index([userId])
  @@index([scheduleId])
  @@index([pnr])
  @@index([status])
  @@map("bookings")
}

model Passenger {
  id String @id @default(uuid())

  bookingId String

  name String

  age Int

  gender PassengerGender

  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  seatAssignment SeatAssignment?

  @@map("passengers")
}

model SeatAssignment {
  id String @id @default(uuid())

  bookingId String

  passengerId String @unique

  seatId String

  coachNumber String

  coachType String

  seatNumber Int

  seatLabel String

  seatType String

  fare Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  passenger Passenger @relation(fields: [passengerId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("seat_assignments")
}

model Payment {
  id String @id @default(uuid())

  bookingId String @unique

  provider String

  orderId String @unique

  transactionId String?

  amount Decimal @db.Decimal(10, 2)

  currency String

  status PaymentStatus

  paidAt DateTime?

  refundedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("payments")
}

model SagaLog {
  id String @id @default(uuid())

  bookingId String

  step SagaStep

  status SagaStatus

  request Json?

  response Json?

  error String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([step])
  @@map("saga_logs")
}

model IdempotencyRecord {
  id String @id @default(uuid())

  key String @unique

  response Json?

  createdAt DateTime @default(now())

  @@index([key])
  @@map("idempotency_records")
}
